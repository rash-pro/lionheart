# Bootstrap the small host generator before configuring the developer build.
# Cache policy belongs to the generator library, also used by embedding hosts.
cmake_minimum_required(VERSION 3.21)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(jobs 8)
set(flag "")
set(parsing OFF)
foreach(index RANGE 0 ${CMAKE_ARGC})
  set(arg "${CMAKE_ARGV${index}}")
  if(NOT parsing)
    if(script_arg)
      set(parsing ON)
    elseif(arg STREQUAL "-P")
      set(script_arg ON)
    endif()
    continue()
  endif()
  if(arg STREQUAL "" OR arg STREQUAL "--")
    continue()
  endif()
  if(arg STREQUAL "--help" OR arg STREQUAL "-h")
    message("usage: cmake -P tools/setup.cmake -- --disc1 CUE [--disc2 CUE] [--disc3 CUE] [--disc4 CUE] [--jobs 1..8]")
    return()
  endif()
  if(flag)
    set(${flag} "${arg}")
    set(flag "")
  elseif(arg MATCHES "^--(disc[1-4]|jobs)=(.+)$")
    set(${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  elseif(arg MATCHES "^--(disc[1-4]|jobs)$")
    set(flag "${CMAKE_MATCH_1}")
  else()
    message(FATAL_ERROR "setup: unknown argument ${arg}")
  endif()
endforeach()
if(flag)
  message(FATAL_ERROR "setup: --${flag} needs a value")
endif()
if(NOT disc1)
  message(FATAL_ERROR "setup: --disc1 is required")
endif()
if(NOT jobs MATCHES "^[1-8]$")
  message(FATAL_ERROR "setup: --jobs must be from 1 to 8")
endif()
set(discs "")
set(run_discs "")
foreach(number RANGE 1 4)
  if(DEFINED disc${number})
    get_filename_component(cue "${disc${number}}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    list(APPEND discs --disc "${cue}")
    # Printed as separate quoted arguments for the developer host.
    string(REPLACE "'" "'\\''" quoted "${cue}")
    string(APPEND run_discs " --disc '${quoted}'")
  endif()
endforeach()
file(MAKE_DIRECTORY "${root}/build")
file(LOCK "${root}/build/setup.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
  message(FATAL_ERROR "setup: another setup owns build/")
endif()
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${root}" RESULT_VARIABLE result)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "setup: command failed (${result}): ${ARGV}")
  endif()
endfunction()
string(TIMESTAMP started "%s" UTC)
run("${CMAKE_COMMAND}" -S "${root}/generator" -B "${root}/build/generator" -DCMAKE_BUILD_TYPE=Release)
run("${CMAKE_COMMAND}" --build "${root}/build/generator" --config Release --target lionheart-gen -j "${jobs}")
set(generator "${root}/build/generator/lionheart-gen")
if(CMAKE_HOST_WIN32)
  set(generator "${generator}.exe")
  if(EXISTS "${root}/build/generator/Release/lionheart-gen.exe")
    set(generator "${root}/build/generator/Release/lionheart-gen.exe")
  endif()
endif()
string(TIMESTAMP generation_started "%s" UTC)
execute_process(COMMAND "${generator}" ${discs} --catalog "${root}/games/ff8-usa" -o "${root}/build/generated"
    --legacy-overlays --cache --mode fast --host-mode precise --timing exact
    WORKING_DIRECTORY "${root}" OUTPUT_VARIABLE generation_log RESULT_VARIABLE result)
message("${generation_log}")
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "setup: generation failed (${result})")
endif()
set(cache_hit false)
if(generation_log MATCHES "Catalog cache hit:")
  set(cache_hit true)
endif()
file(STRINGS "${root}/build/generated/setup-cache.native" cache_header LIMIT_COUNT 2)
list(GET cache_header 1 cache_key)
string(TIMESTAMP generation_ended "%s" UTC)
run("${CMAKE_COMMAND}" -S "${root}" -B "${root}/build/dev" -DCMAKE_BUILD_TYPE=Release
    -DFF8_PLAYER=OFF "-DGENERATED_DIR=${root}/build/generated" -DFF8_GUI=ON -DFF8_NFD=ON
    -DFF8_VULKAN=ON -DFF8_PGXP=ON -DFF8_STATS=ON -DFF8_MOVIES=ON -DFF8_RCHEEVOS=ON
    -DFF8_STATE_BRIDGE=ON -DFF8_SAVESTATES=ON)
run("${CMAKE_COMMAND}" --build "${root}/build/dev" --config Release -j "${jobs}")
string(TIMESTAMP ended "%s" UTC)
math(EXPR total "${ended} - ${started}")
math(EXPR catalog "${generation_ended} - ${generation_started}")
file(WRITE "${root}/build/setup-timing.json"
  "{\n  \"cache_hit\": ${cache_hit},\n  \"catalog_seconds\": ${catalog},\n  \"total_seconds\": ${total},\n  \"key\": \"${cache_key}\"\n}\n")
message("Setup complete in ${total}s (catalog ${catalog}s).")
message("Run: '${root}/build/dev/ff8' '${root}/build/generated/extracted/SLUS_008.92' --gui${run_discs}")
