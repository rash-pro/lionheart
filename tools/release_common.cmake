cmake_minimum_required(VERSION 3.21)
get_filename_component(RELEASE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(release_default name value)
  if(NOT DEFINED ${name})
    set(${name} "${value}" PARENT_SCOPE)
  endif()
endfunction()

function(release_run)
  message(STATUS "${ARGV}")
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Command failed (${status}): ${ARGV}")
  endif()
endfunction()

function(release_jobs)
  release_default(JOBS 4)
  if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be positive")
  endif()
  set(JOBS "${JOBS}" PARENT_SCOPE)
endfunction()
