# Synthetic cache contracts run offline and never touch the real dependency tree.
include("${CMAKE_CURRENT_LIST_DIR}/release_common.cmake")
release_default(TEST_ROOT "${RELEASE_ROOT}/build/release-contracts")
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(RANDOM LENGTH 12 suffix)
set(fixture "${TEST_ROOT}/${suffix}")
file(MAKE_DIRECTORY "${fixture}/tools" "${fixture}/input/top" "${fixture}/downloads")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/release_common.cmake"
          "${CMAKE_CURRENT_LIST_DIR}/fetch_windows_deps.cmake" DESTINATION "${fixture}/tools")
file(WRITE "${fixture}/input/top/NOTICE" "Synthetic dependency notice\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cfz "${fixture}/downloads/fixture.tar.gz" top
                WORKING_DIRECTORY "${fixture}/input" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${fixture}/downloads/fixture.tar.gz" hash)
file(SIZE "${fixture}/downloads/fixture.tar.gz" bytes)
file(WRITE "${fixture}/tools/windows-deps.json"
  "[{\"name\":\"fixture\",\"version\":\"1\",\"url\":\"https://invalid.example/fixture.tar.gz\","
  "\"sha256\":\"${hash}\",\"size\":${bytes},\"licence\":\"BSD-2-Clause\"}]\n")
function(fetch_case name root cache expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DDEPS=${root}" "-DCACHE=${cache}" -DOFFLINE=ON
                  -P "${fixture}/tools/fetch_windows_deps.cmake"
                  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(WRITE "${fixture}/${name}.log" "${out}${err}")
  if(expected STREQUAL "success")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name}: ${out}${err}")
    endif()
  elseif(result EQUAL 0 OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected rejection '${expected}', got ${result}: ${out}${err}")
  endif()
  message(STATUS "${name}: passed")
endfunction()
fetch_case(extract "${fixture}/deps" "${fixture}/downloads" success)
file(READ "${fixture}/deps/fixture-1/NOTICE" notice)
if(NOT notice STREQUAL "Synthetic dependency notice\n")
  message(FATAL_ERROR "extracted notice changed")
endif()
fetch_case(reuse "${fixture}/deps" "${fixture}/downloads" success)
file(APPEND "${fixture}/deps/fixture-1/SOURCE.md" "foreign provenance\n")
fetch_case(foreign_source "${fixture}/deps" "${fixture}/downloads" "Different provenance")
file(COPY "${fixture}/downloads/fixture.tar.gz" DESTINATION "${fixture}/corrupt")
file(APPEND "${fixture}/corrupt/fixture.tar.gz" "corrupt")
fetch_case(corrupt_archive "${fixture}/fresh" "${fixture}/corrupt" "Artifact identity mismatch")
fetch_case(corrupt_restored_archive "${fixture}/deps" "${fixture}/corrupt" "Artifact identity mismatch")
fetch_case(missing_cache "${fixture}/fresh" "${fixture}/missing" "Missing cached artifact")
file(MAKE_DIRECTORY "${fixture}/unmarked/fixture-1")
fetch_case(unmarked_source "${fixture}/unmarked" "${fixture}/downloads" "Missing provenance")
# A matching digest alone is insufficient: the manifest also locks the size.
math(EXPR wrong_bytes "${bytes}+1")
file(READ "${fixture}/tools/windows-deps.json" manifest)
string(REPLACE "\"size\":${bytes}" "\"size\":${wrong_bytes}" manifest "${manifest}")
file(WRITE "${fixture}/tools/windows-deps.json" "${manifest}")
fetch_case(wrong_size "${fixture}/fresh" "${fixture}/downloads" "Artifact identity mismatch")
# A download that is not an archive, such as the AppImage runtime, is kept as is.
file(WRITE "${fixture}/downloads/tool-x86_64" "Synthetic program\n")
file(SHA256 "${fixture}/downloads/tool-x86_64" hash)
file(SIZE "${fixture}/downloads/tool-x86_64" bytes)
file(WRITE "${fixture}/tools/windows-deps.json"
  "[{\"name\":\"tool\",\"version\":\"1\",\"url\":\"https://invalid.example/tool-x86_64\","
  "\"sha256\":\"${hash}\",\"size\":${bytes},\"licence\":\"MIT\"}]\n")
fetch_case(plain "${fixture}/plain" "${fixture}/downloads" success)
file(READ "${fixture}/plain/tool-1/tool-x86_64" program)
if(NOT program STREQUAL "Synthetic program\n" OR NOT EXISTS "${fixture}/plain/tool-1/SOURCE.md")
  message(FATAL_ERROR "plain download changed")
endif()
fetch_case(plain_reuse "${fixture}/plain" "${fixture}/downloads" success)
message(STATUS "Release cache contracts passed; receipts: ${fixture}")
