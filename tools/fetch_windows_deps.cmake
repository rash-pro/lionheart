include("${CMAKE_CURRENT_LIST_DIR}/release_common.cmake")

function(fetch_windows_deps root cache)
  fetch_locked_deps("${RELEASE_ROOT}/tools/windows-deps.json" "${root}" "${cache}")
  foreach(name llvm-mingw SDL2 zlib ffmpeg)
    set("DEP_${name}" "${DEP_${name}}" PARENT_SCOPE)
  endforeach()
endfunction()

# Each lock entry becomes ${root}/NAME-VERSION with its provenance in SOURCE.md
# and DEP_NAME pointing at it. An archive is unpacked; any other download (a
# program) is kept under its own name in that folder.
function(fetch_locked_deps lock root cache)
  file(READ "${lock}" manifest)
  string(JSON count LENGTH "${manifest}")
  math(EXPR last "${count}-1")
  file(MAKE_DIRECTORY "${root}" "${cache}")
  foreach(i RANGE ${last})
    set(source "{\n")
    foreach(key name version url sha256 size licence)
      string(JSON ${key} GET "${manifest}" ${i} ${key})
      if(key STREQUAL "size")
        string(APPEND source "  \"${key}\": ${${key}},\n")
      else()
        string(REPLACE "\\" "\\\\" escaped "${${key}}")
        string(REPLACE "\"" "\\\"" escaped "${escaped}")
        string(APPEND source "  \"${key}\": \"${escaped}\",\n")
      endif()
    endforeach()
    string(REGEX REPLACE ",\n$" "\n}\n" source "${source}")
    set(dest "${root}/${name}-${version}")
    get_filename_component(filename "${url}" NAME)
    set(archive "${cache}/${filename}")
    # Even a restored download cache must prove the locked artifact identity.
    if(EXISTS "${archive}")
      file(SHA256 "${archive}" digest)
      file(SIZE "${archive}" bytes)
      if(NOT digest STREQUAL sha256 OR NOT bytes EQUAL size)
        message(FATAL_ERROR "Artifact identity mismatch: ${archive}")
      endif()
    endif()
    if(EXISTS "${dest}/SOURCE.md")
      file(READ "${dest}/SOURCE.md" previous)
      if(NOT previous STREQUAL source)
        message(FATAL_ERROR "Different provenance at ${dest}")
      endif()
    else()
      if(EXISTS "${dest}")
        message(FATAL_ERROR "Missing provenance at ${dest}; use an empty dependency root")
      endif()
      if(NOT EXISTS "${archive}")
        if(OFFLINE)
          message(FATAL_ERROR "Missing cached artifact: ${archive}")
        endif()
        message(STATUS "Missing cache; downloading ${url}")
        file(DOWNLOAD "${url}" "${archive}.partial" EXPECTED_HASH "SHA256=${sha256}"
             TLS_VERIFY ON STATUS download)
        list(GET download 0 status)
        if(NOT status EQUAL 0)
          message(FATAL_ERROR "Download failed: ${download}")
        endif()
        file(SIZE "${archive}.partial" bytes)
        if(NOT bytes EQUAL size)
          message(FATAL_ERROR "Artifact identity mismatch: ${archive}")
        endif()
        file(RENAME "${archive}.partial" "${archive}")
      endif()
      set(unpack "${root}/.unpack-${name}")
      file(REMOVE_RECURSE "${unpack}")
      file(MAKE_DIRECTORY "${unpack}")
      if(filename MATCHES "[.](tar[.](gz|xz|bz2)|tgz|zip)$")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpack}")
        file(GLOB children LIST_DIRECTORIES TRUE "${unpack}/*")
        list(LENGTH children tops)
        if(NOT tops EQUAL 1 OR NOT IS_DIRECTORY "${children}")
          message(FATAL_ERROR "Expected one enclosing directory: ${archive}")
        endif()
      else()
        set(children "${unpack}/${name}")
        file(MAKE_DIRECTORY "${children}")
        file(COPY "${archive}" DESTINATION "${children}")
      endif()
      file(RENAME "${children}" "${dest}")
      file(REMOVE_RECURSE "${unpack}")
      file(WRITE "${dest}/SOURCE.md" "${source}")
    endif()
    set("DEP_${name}" "${dest}" PARENT_SCOPE)
    message(STATUS "${name}: ${dest}")
  endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  release_default(DEPS "${RELEASE_ROOT}/build/windows-deps")
  release_default(CACHE "${RELEASE_ROOT}/build/downloads")
  fetch_windows_deps("${DEPS}" "${CACHE}")
endif()
