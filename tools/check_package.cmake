# Checks a release package before it is published:
#   cmake -DPACKAGE=build/packages/Lionheart-0.1.0-x86_64.AppImage -P tools/check_package.cmake
#   cmake -DPACKAGE=build/packages/Lionheart-0.1.0-windows-x86_64.zip -P tools/check_package.cmake
# It unpacks the package into WORK (default: beside it) and fails unless
#  - it holds only the player, the libraries it loads, its desktop files and
#    its notices: no compiler and nothing else;
#  - every library a program in it loads is either in it or one the system
#    provides (the lists below);
#  - every bundled component is under an accepted licence and its notices,
#    with the LGPL source offer, are inside;
#  - the version and icon the package shows are this checkout's.
# With -DSCANNER=check_player_binary and -DEXE=PATH, the release scan also runs
# on the packaged player (-DCOMPILE_COMMANDS=PATH adds the build's audit).
# It needs objdump from binutils and, for an AppImage, a system that can run it.
include("${CMAKE_CURRENT_LIST_DIR}/release_common.cmake")
if(NOT DEFINED PACKAGE OR NOT EXISTS "${PACKAGE}")
  message(FATAL_ERROR "Specify -DPACKAGE=path to an AppImage or a Windows zip")
endif()
get_filename_component(PACKAGE "${PACKAGE}" ABSOLUTE)
get_filename_component(name "${PACKAGE}" NAME)
release_default(WORK "${PACKAGE}.check")
get_filename_component(WORK "${WORK}" ABSOLUTE)
file(READ "${RELEASE_ROOT}/CMakeLists.txt" top)
string(REGEX MATCH "project\\(lionheart VERSION ([0-9]+[.][0-9]+[.][0-9]+)" ignored "${top}")
release_default(VERSION "${CMAKE_MATCH_1}")
set(failures "")
macro(fail text)
  string(APPEND failures "  ${text}\n")
endmacro()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(name STREQUAL "Lionheart-${VERSION}-x86_64.AppImage")
  set(kind appimage)
  execute_process(COMMAND "${PACKAGE}" --appimage-extract WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
  set(root "${WORK}/squashfs-root")
  if(NOT status EQUAL 0 OR NOT EXISTS "${root}/AppRun")
    message(FATAL_ERROR "Cannot extract ${PACKAGE}: ${error}")
  endif()
  set(player "${root}/usr/bin/lionheart")
  set(notices "${root}/usr/share/doc/lionheart/licences")
elseif(name STREQUAL "Lionheart-${VERSION}-windows-x86_64.zip")
  set(kind windows)
  file(ARCHIVE_EXTRACT INPUT "${PACKAGE}" DESTINATION "${WORK}")
  file(GLOB tops RELATIVE "${WORK}" "${WORK}/*")
  if(NOT tops STREQUAL "Lionheart")
    fail("the zip must hold one folder named Lionheart, not: ${tops}")
  endif()
  set(root "${WORK}/Lionheart")
  set(player "${root}/Lionheart.exe")
  set(notices "${root}/licences")
else()
  message(FATAL_ERROR "${name} is not a Lionheart ${VERSION} package name")
endif()

# Contents. The Windows folder may also hold a user's portable data; nothing in
# the zip may share a name with it, which these patterns guarantee.
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*" "${root}/.*")
list(SORT files)
if(kind STREQUAL "appimage")
  set(allowed "^(AppRun|lionheart[.]desktop|lionheart[.]png|[.]DirIcon|usr/bin/lionheart|usr/lib/lib[^/]+[.]so[.][0-9.]+"
    "|usr/share/applications/lionheart[.]desktop|usr/share/icons/hicolor/[0-9]+x[0-9]+/apps/lionheart[.]png"
    "|usr/share/doc/lionheart/dependencies[.]json|usr/share/doc/lionheart/licences/[^/]+)$")
else()
  set(allowed "^(Lionheart[.]exe|[^/]+[.]dll|dependencies[.]json|licences/[^/]+)$")
endif()
string(JOIN "" allowed ${allowed})
set(libraries)
foreach(file IN LISTS files)
  if(NOT file MATCHES "${allowed}")
    fail("unexpected file ${file}")
  elseif(IS_SYMLINK "${root}/${file}" AND NOT file STREQUAL ".DirIcon")
    fail("unexpected link ${file}")
  elseif(file MATCHES "^usr/lib/|[.]dll$")
    list(APPEND libraries "${file}")
  endif()
endforeach()
if(NOT EXISTS "${player}")
  message(FATAL_ERROR "No player in ${PACKAGE}")
endif()

# Each bundled component: the files that are it, its licence and the notices
# it needs. Lionheart's own and vendored code is in the player of both.
set(components
  "Lionheart@MIT@^(usr/bin/lionheart|Lionheart[.]exe)$@Lionheart-MIT.txt,THIRD_PARTY_NOTICES.md"
  "parallel-psx@ISC@@parallel-psx-ISC.txt"
  "volk@MIT@@volk-MIT.h"
  "rcheevos@MIT@@rcheevos-MIT.txt"
  "Spleen@BSD-2-Clause@@Spleen-BSD-2.txt"
  "Dear ImGui@MIT@@Dear-ImGui-MIT.txt"
  "nativefiledialog-extended@zlib@@nativefiledialog-zlib.txt"
  "Chakra Petch@OFL-1.1@@Chakra-Petch-OFL.txt"
  "zlib@zlib@@zlib.txt"
  "SDL2@zlib@^(usr/lib/libSDL2-2[.]0[.]so[.]0|SDL2[.]dll)$@SDL2-zlib.txt"
  "FFmpeg@LGPL-2.1-or-later@^(usr/lib/lib(avformat|avcodec|avutil|swscale)[.]so[.][0-9]+|(avformat|avcodec|avutil|swscale)-[0-9]+[.]dll)$@FFmpeg-LGPL-2.1.txt,FFmpeg-configure.txt,FFmpeg-source.txt")
if(kind STREQUAL "appimage")
  list(APPEND components
    "libcurl@curl@^usr/lib/libcurl[.]so[.]4$@curl.txt"
    "AppImage runtime@MIT,BSD-2-Clause,public-domain@@AppImage-runtime.txt")
else()
  list(APPEND components
    "llvm-mingw C++ runtime@Apache-2.0 WITH LLVM-exception@^(libc[+][+]|libunwind)[.]dll$@llvm-mingw-runtime.txt"
    "MinGW-w64 runtime and winpthreads@MIT,ZPL-2.1,public-domain@^libwinpthread-1[.]dll$@COPYING.MinGW-w64-runtime.txt,COPYING.winpthreads.txt")
endif()
# What a package may carry. FFmpeg comes only as replaceable shared libraries
# and fonts under the OFL. The Windows player cannot run without the C++
# runtime of the compiler that builds it, which is Apache-2.0 with the LLVM
# exception (the exception waives notices for compiled code; they ship anyway).
set(accepted MIT ISC BSD-2-Clause BSD-3-Clause zlib MPL-2.0 curl public-domain ZPL-2.1 OFL-1.1
  LGPL-2.1-or-later "Apache-2.0 WITH LLVM-exception")
set(claimed)
foreach(component IN LISTS components)
  string(REPLACE "@" ";" fields "${component}")
  list(GET fields 0 title)
  list(GET fields 1 licences)
  list(GET fields 2 pattern)
  list(GET fields 3 needed)
  string(REPLACE "," ";" licences "${licences}")
  string(REPLACE "," ";" needed "${needed}")
  foreach(licence IN LISTS licences)
    if(NOT licence IN_LIST accepted)
      fail("${title} is under ${licence}, which a package may not carry")
    endif()
  endforeach()
  foreach(notice IN LISTS needed)
    if(NOT EXISTS "${notices}/${notice}")
      fail("${title}: missing notice ${notice}")
    else()
      file(SIZE "${notices}/${notice}" bytes)
      if(bytes LESS 64)
        fail("${title}: notice ${notice} is empty")
      endif()
    endif()
  endforeach()
  if(pattern)
    foreach(file IN LISTS files)
      if(file MATCHES "${pattern}")
        list(APPEND claimed "${file}")
      endif()
    endforeach()
  endif()
endforeach()
foreach(file IN LISTS libraries)
  if(NOT file IN_LIST claimed)
    fail("${file} belongs to no known component: add it, its licence and its notices here")
  endif()
endforeach()
if(EXISTS "${notices}/FFmpeg-source.txt")
  file(READ "${notices}/FFmpeg-source.txt" offer)
  if(NOT offer MATCHES "https://ffmpeg[.]org/releases/ffmpeg-[0-9.]+[.]tar[.]xz" OR NOT offer MATCHES "replace")
    fail("FFmpeg-source.txt lacks the source offer")
  endif()
endif()
foreach(notice IN ITEMS FFmpeg-LGPL-2.1.txt)
  if(EXISTS "${notices}/${notice}")
    file(READ "${notices}/${notice}" text)
    if(NOT text MATCHES "GNU LESSER GENERAL PUBLIC LICENSE")
      fail("${notice} is not the LGPL")
    endif()
  endif()
endforeach()

# What each program loads, and from where.
set(system_elf libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 ld-linux-x86-64.so.2 libgcc_s.so.1
  libstdc++.so.6 libdbus-1.so.3 libssl.so.3 libcrypto.so.3)
set(system_pe kernel32.dll user32.dll gdi32.dll shell32.dll ole32.dll oleaut32.dll advapi32.dll winmm.dll msvcrt.dll
  version.dll imm32.dll setupapi.dll cfgmgr32.dll ws2_32.dll winhttp.dll bcrypt.dll secur32.dll shlwapi.dll
  dwmapi.dll uxtheme.dll comdlg32.dll hid.dll dinput8.dll xinput1_4.dll ntdll.dll crypt32.dll)
set(glibc "")
set(glibcxx "")
function(version_max list output)
  set(best "")
  foreach(v IN LISTS list)
    if(best STREQUAL "" OR v VERSION_GREATER best)
      set(best "${v}")
    endif()
  endforeach()
  set(${output} "${best}" PARENT_SCOPE)
endfunction()
set(programs "${player}")
if(kind STREQUAL "appimage")
  list(APPEND programs "${root}/AppRun")
endif()
foreach(file IN LISTS libraries)
  list(APPEND programs "${root}/${file}")
endforeach()
foreach(program IN LISTS programs)
  file(RELATIVE_PATH shown "${root}" "${program}")
  execute_process(COMMAND objdump -p "${program}" OUTPUT_VARIABLE dump RESULT_VARIABLE status ERROR_QUIET)
  if(NOT status EQUAL 0)
    fail("objdump cannot read ${shown}")
    continue()
  endif()
  if(kind STREQUAL "appimage")
    string(REGEX MATCHALL "NEEDED +[^\n]+" lines "${dump}")
    string(REGEX MATCH "(RPATH|RUNPATH) +[^\n]+" path "${dump}")
    string(REGEX REPLACE "^(RPATH|RUNPATH) +" "" path "${path}")
    if(program STREQUAL player AND NOT dump MATCHES "RUNPATH +\\$ORIGIN/[.][.]/lib\n")
      fail("the player must find its libraries by RUNPATH $ORIGIN/../lib")
    elseif(NOT program STREQUAL player AND NOT path STREQUAL "" AND NOT path STREQUAL "$ORIGIN")
      fail("${shown} searches ${path}")
    endif()
    string(REGEX MATCHALL "GLIBC_[0-9.]+" versions "${dump}")
    string(REPLACE "GLIBC_" "" versions "${versions}")
    list(APPEND glibc ${versions})
    string(REGEX MATCHALL "GLIBCXX_[0-9.]+" versions "${dump}")
    string(REPLACE "GLIBCXX_" "" versions "${versions}")
    list(APPEND glibcxx ${versions})
  else()
    string(REGEX MATCHALL "DLL Name: [^\n]+" lines "${dump}")
  endif()
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "^(NEEDED +|DLL Name: )" "" dependency "${line}")
    string(STRIP "${dependency}" dependency)
    if(kind STREQUAL "appimage")
      if(EXISTS "${root}/usr/lib/${dependency}")
        # A run path is per object: a library's own dependency resolves
        # through its own, or by name because the player, whose dependencies
        # the loader maps first, needs it too.
        if(program STREQUAL player)
          list(APPEND player_needs "${dependency}")
        elseif(NOT path STREQUAL "$ORIGIN" AND NOT dependency IN_LIST player_needs)
          fail("${shown} cannot find ${dependency}")
        endif()
      elseif(NOT dependency IN_LIST system_elf)
        fail("${shown} needs ${dependency}, which is neither bundled nor a system library")
      endif()
    else()
      string(TOLOWER "${dependency}" lower)
      if(NOT EXISTS "${root}/${dependency}" AND NOT lower IN_LIST system_pe AND NOT lower MATCHES "^api-ms-win-")
        fail("${shown} imports ${dependency}, which is neither bundled nor part of Windows")
      endif()
    endif()
  endforeach()
endforeach()

# Version and icon.
if(kind STREQUAL "appimage")
  file(READ "${root}/lionheart.desktop" entry)
  foreach(line "Exec=lionheart" "Icon=lionheart" "X-AppImage-Version=${VERSION}")
    if(NOT entry MATCHES "(^|\n)${line}\n")
      fail("lionheart.desktop lacks ${line}")
    endif()
  endforeach()
  file(SHA256 "${root}/lionheart.png" icon)
  file(SHA256 "${RELEASE_ROOT}/assets/logo/icon-256.png" expected)
  if(NOT icon STREQUAL expected)
    fail("lionheart.png is not the project icon")
  endif()
  if(NOT IS_SYMLINK "${root}/.DirIcon")
    fail(".DirIcon is missing")
  else()
    file(READ_SYMLINK "${root}/.DirIcon" target)
    if(NOT target STREQUAL "lionheart.png")
      fail(".DirIcon points at ${target}")
    endif()
  endif()
  foreach(size 16 24 32 48 64 128 256 512)
    set(installed "${root}/usr/share/icons/hicolor/${size}x${size}/apps/lionheart.png")
    file(SHA256 "${RELEASE_ROOT}/assets/logo/icon-${size}.png" expected)
    if(NOT EXISTS "${installed}")
      fail("no ${size}px icon")
    else()
      file(SHA256 "${installed}" icon)
      if(NOT icon STREQUAL expected)
        fail("the ${size}px icon is not the project icon")
      endif()
    endif()
  endforeach()
  file(STRINGS "${player}" found REGEX "^(.* )?${VERSION}$")
  if(NOT found)
    fail("the player does not carry version ${VERSION}")
  endif()
else()
  string(REPLACE "." ";" parts "${VERSION}")
  list(GET parts 0 major)
  list(GET parts 1 minor)
  list(GET parts 2 patch)
  # Only the strings concerned: others may hold brackets, which CMake lists treat specially.
  file(STRINGS "${player}" strings ENCODING UTF-16LE REGEX "^(FileVersion|ProductVersion|[0-9]+[.][0-9]+[.][0-9]+)$")
  list(LENGTH strings string_count)
  foreach(key FileVersion ProductVersion)
    list(FIND strings "${key}" at)
    math(EXPR next "${at}+1")
    if(at LESS 0 OR NOT next LESS string_count)
      fail("no ${key} resource")
    else()
      list(GET strings ${next} value)
      if(NOT value STREQUAL VERSION)
        fail("${key} is ${value}, not ${VERSION}")
      endif()
    endif()
  endforeach()
  file(READ "${player}" hex HEX)
  # VS_FIXEDFILEINFO: signature, structure version, then MS and LS halves.
  macro(word16 value out)
    math(EXPR ${out} "${value}" OUTPUT_FORMAT HEXADECIMAL)
    string(REPLACE "0x" "" ${out} "${${out}}")
    string(LENGTH "${${out}}" length)
    while(length LESS 4)
      string(PREPEND ${out} "0")
      math(EXPR length "${length}+1")
    endwhile()
    string(REGEX REPLACE "^(..)(..)$" "\\2\\1" ${out} "${${out}}")
    string(TOLOWER "${${out}}" ${out})
  endmacro()
  word16("${major}" a)
  word16("${minor}" b)
  word16("${patch}" c)
  set(fixed "bd04effe00000100${b}${a}0000${c}${b}${a}0000${c}")
  string(FIND "${hex}" "${fixed}" at)
  if(at LESS 0)
    fail("the fixed version resource is not ${VERSION}")
  endif()
  file(STRINGS "${player}" manifest REGEX "assemblyIdentity")
  if(NOT manifest MATCHES "version=\"${major}[.]${minor}[.]${patch}[.]0\"")
    fail("the manifest is not version ${VERSION}")
  endif()
  # Every image of the project icon is in the resources unchanged.
  file(READ "${RELEASE_ROOT}/assets/logo/lionheart.ico" ico HEX)
  string(SUBSTRING "${ico}" 8 4 count)
  string(REGEX REPLACE "^(..)(..)$" "0x\\2\\1" count "${count}")
  math(EXPR count "${count}")
  math(EXPR last "${count}-1")
  foreach(i RANGE ${last})
    math(EXPR entry "(6 + 16 * ${i}) * 2")
    math(EXPR size_at "${entry} + 16")
    math(EXPR offset_at "${entry} + 24")
    foreach(field size offset)
      string(SUBSTRING "${ico}" ${${field}_at} 8 raw)
      string(REGEX REPLACE "^(..)(..)(..)(..)$" "0x\\4\\3\\2\\1" raw "${raw}")
      math(EXPR ${field} "${raw}")
    endforeach()
    math(EXPR offset "${offset} * 2")
    math(EXPR size "${size} * 2")
    string(SUBSTRING "${ico}" ${offset} ${size} image)
    string(FIND "${hex}" "${image}" at)
    if(at LESS 0)
      fail("icon image ${i} is not in Lionheart.exe")
    endif()
  endforeach()
endif()

if(DEFINED SCANNER)
  set(scan "${SCANNER}" "${player}" "${EXE}")
  if(DEFINED COMPILE_COMMANDS)
    list(APPEND scan --compile-commands "${COMPILE_COMMANDS}")
  endif()
  execute_process(COMMAND ${scan} RESULT_VARIABLE status OUTPUT_VARIABLE receipt ERROR_VARIABLE error)
  file(WRITE "${WORK}/scan.json" "${receipt}")
  if(NOT status EQUAL 0)
    fail("release scan failed (${status}): ${error}")
  endif()
endif()

if(kind STREQUAL "appimage")
  version_max("${glibc}" glibc)
  version_max("${glibcxx}" glibcxx)
  message(STATUS "Needs from the system: glibc ${glibc}, libstdc++ (GLIBCXX) ${glibcxx}")
endif()
list(JOIN libraries " " shown)
message(STATUS "Bundled libraries: ${shown}")
if(failures)
  message(FATAL_ERROR "${name} failed its check:\n${failures}")
endif()
file(SHA256 "${PACKAGE}" hash)
file(SIZE "${PACKAGE}" bytes)
message(STATUS "${name}: passed (${bytes} bytes, SHA-256 ${hash})")
