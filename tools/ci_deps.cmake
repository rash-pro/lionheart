include("${CMAKE_CURRENT_LIST_DIR}/release_common.cmake")
if(NOT PLATFORM MATCHES "^(linux|windows)$")
  message(FATAL_ERROR "Set -DPLATFORM=linux or -DPLATFORM=windows")
endif()
set(programs cc c++ cmake make pkg-config tar xz glslc)
set(modules vulkan)
set(packages build-essential cmake pkg-config libvulkan-dev glslc xz-utils)
# The Windows job also builds the Linux case runner and its host-side tools.
if(PLATFORM MATCHES "^(linux|windows)$")
  list(APPEND programs ffmpeg)
  list(APPEND modules sdl2 zlib libavformat libavcodec libavutil libswscale dbus-1 libcurl)
  list(APPEND packages libsdl2-dev zlib1g-dev libavformat-dev libavcodec-dev libavutil-dev
       libswscale-dev libdbus-1-dev libcurl4-openssl-dev ffmpeg)
endif()
if(PLATFORM STREQUAL "windows")
  list(APPEND programs wine)
  list(APPEND packages wine)
endif()
function(prerequisites_ready output)
  set(ready TRUE)
  foreach(program IN LISTS programs)
    unset(found)
    unset(found CACHE)
    find_program(found NAMES "${program}")
    if(NOT found)
      set(ready FALSE)
    endif()
  endforeach()
  execute_process(COMMAND pkg-config --exists ${modules} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    set(ready FALSE)
  endif()
  set(${output} "${ready}" PARENT_SCOPE)
endfunction()
prerequisites_ready(ready)
if(NOT ready)
  find_program(apt apt-get)
  if(NOT apt)
    message(FATAL_ERROR "Install these build requirements with your package manager: ${packages}")
  endif()
  release_run(sudo "${apt}" update)
  release_run(sudo "${apt}" install -y ${packages})
  prerequisites_ready(ready)
  if(NOT ready)
    message(FATAL_ERROR "Build prerequisites are still unavailable")
  endif()
endif()
message(STATUS "${PLATFORM}: all build prerequisites are available")
