cmake_minimum_required(VERSION 3.21)
# Public metadata only; usable independently by native test fixtures.
file(READ "${INPUT}/exe-identity.json" exe)
foreach(key base size fnv1a file_size sha1)
  string(JSON ${key} GET "${exe}" ${key})
endforeach()
set(out "/* Identity facts only. See JSON metadata in games/ff8-usa. */\n#define HOST_EXE_BASE ${base}u\n#define HOST_EXE_SIZE ${size}u\n#define HOST_EXE_FNV 0x${fnv1a}u\n#define HOST_EXE_FILE_SIZE ${file_size}u\n#define HOST_EXE_SHA1 \"${sha1}\"\n#ifdef HOST_DISC_TABLE\nstatic const host_disc_metadata_t host_disc_metadata[4] = {\n")
foreach(n RANGE 1 4)
  file(READ "${INPUT}/files-disc${n}.json" disc)
  foreach(key name sha1)
    string(JSON exe_${key} GET "${disc}" exe ${key})
  endforeach()
  foreach(key name lba size sha1)
    string(JSON image_${key} GET "${disc}" image ${key})
  endforeach()
  string(APPEND out "    {\"${exe_name}\", \"${exe_sha1}\", \"${image_name}\", ${image_lba}u, ${image_size}u, \"${image_sha1}\"},\n")
endforeach()
string(APPEND out "};\n#endif\n")
if(CMAKE_HOST_WIN32)
  string(REPLACE "\n" "\r\n" out "${out}")
endif()
file(WRITE "${OUTPUT}" "${out}")
