file(READ "${INPUT}" manifest)
if(WIN32 OR HOST_WINDOWS)
  set(platform x86_64-windows)
else()
  set(platform x86_64-linux)
endif()
string(JSON entry GET "${manifest}" platforms ${platform})
file(WRITE "${OUTPUT}" "/* Compiled from the reviewed toolchain manifest. */\n#include \"toolchain.h\"\n")
foreach(array urls files)
  string(JSON count LENGTH "${entry}" ${array})
  set(${array}_count ${count})
  file(APPEND "${OUTPUT}" "static const char *const ${array}[] = {\n")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
      string(JSON value GET "${entry}" ${array} ${i})
      if(value MATCHES "[\"\\;\n\r]")
        message(FATAL_ERROR "Invalid manifest string")
      endif()
      file(APPEND "${OUTPUT}" "\"${value}\",\n")
    endforeach()
  else()
    file(APPEND "${OUTPUT}" "0,\n")
  endif()
  file(APPEND "${OUTPUT}" "};\n")
endforeach()
foreach(key version format prefix executable sha256 size)
  string(JSON ${key} GET "${entry}" ${key})
endforeach()
file(APPEND "${OUTPUT}" "const host_tc_manifest *host_tc_pinned(void) {\nstatic const host_tc_manifest m = {\"${version}\",\"${format}\",\"${prefix}\",\"${executable}\",\"${sha256}\",${size},urls,${urls_count},files,${files_count}};\nreturn &m;\n}\n")
