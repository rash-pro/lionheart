include("${CMAKE_CURRENT_LIST_DIR}/fetch_windows_deps.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/stage_player.cmake")
release_default(DEPS "${RELEASE_ROOT}/build/windows-deps")
release_default(CACHE "${RELEASE_ROOT}/build/downloads")
release_default(BUILD "${RELEASE_ROOT}/build/windows")
release_jobs()
get_filename_component(DEPS "${DEPS}" ABSOLUTE)
get_filename_component(BUILD "${BUILD}" ABSOLUTE)
fetch_windows_deps("${DEPS}" "${CACHE}")
set(PREFIX "${DEPS}/install-ucrt")
set(ENV{PATH} "${DEP_llvm-mingw}/bin:$ENV{PATH}")
set(ENV{LLVM_MINGW_ROOT} "${DEP_llvm-mingw}")
set(ENV{WINDOWS_DEPS_ROOT} "${PREFIX}")

set(configure "${DEP_ffmpeg}/configure" "--prefix=${PREFIX}"
  --enable-cross-compile --target-os=mingw32 --arch=x86_64
  --cc=x86_64-w64-mingw32-clang --cxx=x86_64-w64-mingw32-clang++
  --ar=llvm-ar --ranlib=llvm-ranlib --nm=llvm-nm --strip=llvm-strip
  --cross-prefix=x86_64-w64-mingw32- --windres=x86_64-w64-mingw32-windres
  --disable-x86asm --disable-autodetect --disable-programs --disable-doc --disable-debug
  --disable-static --enable-shared --disable-network --disable-avdevice --disable-avfilter
  --disable-swresample --disable-encoders --disable-muxers --disable-filters --disable-devices)

# Source markers alone do not identify an installed prefix. Bind reusable
# binaries to the lock, recipe and file contents before relocating metadata.
file(SHA256 "${RELEASE_ROOT}/tools/windows-deps.json" lock_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" recipe_hash)
file(SHA256 "${RELEASE_ROOT}/cmake/toolchains/windows-llvm-mingw.cmake" toolchain_hash)
set(identity "${lock_hash}\n${recipe_hash}\n${toolchain_hash}\n")
function(prefix_receipt output)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${PREFIX}"
       "${PREFIX}/bin/*" "${PREFIX}/lib/*" "${PREFIX}/include/*" "${PREFIX}/share/*")
  list(SORT files)
  set(receipt "${identity}")
  list(APPEND files ffmpeg-configure.txt)
  foreach(file IN LISTS files)
    file(SHA256 "${PREFIX}/${file}" hash)
    string(APPEND receipt "${hash}  ${file}\n")
  endforeach()
  set(${output} "${receipt}" PARENT_SCOPE)
endfunction()
if(EXISTS "${PREFIX}")
  if(NOT EXISTS "${PREFIX}/SOURCE.sha256")
    message(FATAL_ERROR "Missing install provenance at ${PREFIX}; rebuild in an empty dependency root")
  endif()
  prefix_receipt(actual)
  file(READ "${PREFIX}/SOURCE.sha256" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Different install provenance at ${PREFIX}")
  endif()
endif()
file(MAKE_DIRECTORY "${PREFIX}")
set(sdl "${DEP_SDL2}/x86_64-w64-mingw32")
foreach(sub bin include lib share)
  if(EXISTS "${sdl}/${sub}")
    file(COPY "${sdl}/${sub}" DESTINATION "${PREFIX}")
  endif()
endforeach()
if(NOT EXISTS "${PREFIX}/lib/libz.a")
  release_run("${CMAKE_COMMAND}" -S "${DEP_zlib}" -B "${DEP_zlib}/build-ucrt"
    "-DCMAKE_TOOLCHAIN_FILE=${RELEASE_ROOT}/cmake/toolchains/windows-llvm-mingw.cmake"
    "-DCMAKE_INSTALL_PREFIX=${PREFIX}" -DCMAKE_BUILD_TYPE=Release)
  release_run("${CMAKE_COMMAND}" --build "${DEP_zlib}/build-ucrt" --parallel "${JOBS}")
  release_run("${CMAKE_COMMAND}" --install "${DEP_zlib}/build-ucrt")
  configure_file("${PREFIX}/lib/libzlibstatic.a" "${PREFIX}/lib/libz.a" COPYONLY)
  file(GLOB unwanted "${PREFIX}/bin/*zlib*.dll" "${PREFIX}/lib/*zlib.dll.a")
  if(unwanted)
    file(REMOVE ${unwanted})
  endif()
endif()
foreach(headers vulkan vk_video)
  file(COPY "/usr/include/${headers}" DESTINATION "${PREFIX}/include")
endforeach()
file(GLOB metadata "${PREFIX}/lib/pkgconfig/*.pc")
foreach(pc IN LISTS metadata)
  file(READ "${pc}" value)
  if(value MATCHES "(^|\n)prefix=([^\n]+)")
    string(REPLACE "${CMAKE_MATCH_2}" "${PREFIX}" value "${value}")
    file(WRITE "${pc}" "${value}")
  endif()
endforeach()
if(NOT EXISTS "${PREFIX}/lib/libavformat.dll.a")
  set(ffbuild "${DEP_ffmpeg}/build-ucrt")
  file(MAKE_DIRECTORY "${ffbuild}")
  execute_process(COMMAND ${configure} WORKING_DIRECTORY "${ffbuild}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "FFmpeg configure failed: ${status}")
  endif()
  execute_process(COMMAND make "-j${JOBS}" WORKING_DIRECTORY "${ffbuild}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "FFmpeg build failed: ${status}")
  endif()
  execute_process(COMMAND make install WORKING_DIRECTORY "${ffbuild}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "FFmpeg install failed: ${status}")
  endif()
  string(JOIN " " line ${configure})
  file(WRITE "${PREFIX}/ffmpeg-configure.txt" "${line}\n")
endif()
prefix_receipt(receipt)
file(WRITE "${PREFIX}/SOURCE.sha256" "${receipt}")
release_run("${CMAKE_COMMAND}" -S "${RELEASE_ROOT}" -B "${BUILD}"
  "-DCMAKE_TOOLCHAIN_FILE=${RELEASE_ROOT}/cmake/toolchains/windows-llvm-mingw.cmake"
  -DCMAKE_BUILD_TYPE=Release -DFF8_PLAYER=ON -DFF8_STATE_BRIDGE=OFF -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
  "-DZLIB_LIBRARY=${PREFIX}/lib/libz.a" "-DZLIB_INCLUDE_DIR=${PREFIX}/include")
release_run("${CMAKE_COMMAND}" --build "${BUILD}" --target ff8 --parallel "${JOBS}")
set(PLATFORM windows)
stage_player()
