cmake_minimum_required(VERSION 3.21)
# Keep extraction and helper builds outside the checkout and system temp quota.
foreach(required PLATFORM INPUT WORK OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Specify -D${required}=...")
  endif()
endforeach()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(path INPUT WORK OUTPUT)
  get_filename_component(${path} "${${path}}" ABSOLUTE)
endforeach()
file(READ "${root}/data/toolchain/upstream.json" upstream)
string(JSON source GET "${upstream}" "${PLATFORM}" file)
string(JSON expected GET "${upstream}" "${PLATFORM}" sha256)
file(SHA256 "${INPUT}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Official archive SHA-256 mismatch")
endif()
file(READ "${root}/data/toolchain/manifest.json" manifest)
string(JSON entry GET "${manifest}" platforms "${PLATFORM}")
string(JSON prefix GET "${entry}" prefix)
string(JSON executable GET "${entry}" executable)
string(JSON count LENGTH "${entry}" files)
math(EXPR last "${count}-1")
set(files)
foreach(i RANGE 0 ${last})
  string(JSON file GET "${entry}" files ${i})
  list(APPEND files "${file}")
endforeach()
list(APPEND files LICENSE lib/libcxx/LICENSE.TXT NOTICE.txt)
list(REMOVE_DUPLICATES files)
list(SORT files)
if(EXISTS "${WORK}/stage")
  message(FATAL_ERROR "Use a fresh WORK directory")
endif()
set(original "zig-${PLATFORM}-0.17.1")
set(patterns)
foreach(file IN LISTS files)
  if(NOT file STREQUAL "NOTICE.txt")
    list(APPEND patterns "${original}/${file}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}/source" "${WORK}/stage/${prefix}")
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(ARCHIVE_EXTRACT INPUT "${INPUT}" DESTINATION "${WORK}/source" PATTERNS ${patterns})
foreach(file IN LISTS files)
  if(NOT file STREQUAL "NOTICE.txt")
    configure_file("${WORK}/source/${original}/${file}" "${WORK}/stage/${prefix}${file}" COPYONLY)
  endif()
endforeach()
file(WRITE "${WORK}/stage/${prefix}NOTICE.txt"
  "Lionheart trimmed Zig 0.17.1 C compiler toolchain (${PLATFORM}).\nSource: ${source}\nSHA-256: ${expected}\nSelected upstream files are unmodified. NOTICE.txt is added by Lionheart.\nZig: LICENSE (MIT). LLVM: lib/libcxx/LICENSE.TXT (Apache-2.0 with LLVM exception).\n")
file(WRITE "${WORK}/entries.txt" "")
foreach(file IN LISTS files)
  file(APPEND "${WORK}/entries.txt" "${prefix}${file}\n")
endforeach()
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}")
  endif()
endfunction()
run("${CMAKE_COMMAND}" -S "${root}/tools/toolchain-zip" -B "${WORK}/helper")
run("${CMAKE_COMMAND}" --build "${WORK}/helper" --config Release --parallel 4)
set(helper "${WORK}/helper/toolchain-zip${CMAKE_EXECUTABLE_SUFFIX}")
if(WIN32)
  set(helper "${WORK}/helper/toolchain-zip.exe")
endif()
if(EXISTS "${WORK}/helper/Release/toolchain-zip.exe")
  set(helper "${WORK}/helper/Release/toolchain-zip.exe")
endif()
execute_process(COMMAND "${helper}" "${OUTPUT}" "${WORK}/entries.txt" "${prefix}${executable}"
  WORKING_DIRECTORY "${WORK}/stage" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "ZIP writer failed")
endif()
file(SHA256 "${OUTPUT}" hash)
file(SIZE "${OUTPUT}" size)
message(STATUS "${OUTPUT}: ${size} bytes SHA-256 ${hash}")
if(NOT DEFINED VERIFY OR VERIFY)
  string(JSON expected GET "${entry}" sha256)
  string(JSON expected_size GET "${entry}" size)
  if(NOT hash STREQUAL expected OR NOT size EQUAL expected_size)
    message(FATAL_ERROR "Release archive differs from manifest (use -DVERIFY=OFF when preparing a new pin)")
  endif()
endif()
