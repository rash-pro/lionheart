include("${CMAKE_CURRENT_LIST_DIR}/release_common.cmake")
release_default(BUILD "${RELEASE_ROOT}/build/windows-tests")
release_default(PLAYER "${RELEASE_ROOT}/build/windows/dist-windows")
release_default(PLAYER_BUILD "${RELEASE_ROOT}/build/windows")
release_default(BUNDLE "${RELEASE_ROOT}/build/windows-test-bundle")
file(REMOVE_RECURSE "${BUNDLE}")
file(MAKE_DIRECTORY "${BUNDLE}")
file(COPY "${PLAYER}/" DESTINATION "${BUNDLE}")
file(READ "${PLAYER_BUILD}/compile_commands.json" commands)
string(REPLACE "${RELEASE_ROOT}/" "source/" commands "${commands}")
file(WRITE "${BUNDLE}/compile_commands.json" "${commands}")
file(COPY "${BUILD}/lionheart_tests.exe" "${BUILD}/harness" DESTINATION "${BUNDLE}")
foreach(folder tests runtime backends generator games cmake tools third_party)
  file(COPY "${RELEASE_ROOT}/${folder}" DESTINATION "${BUNDLE}/source")
endforeach()
file(COPY "${RELEASE_ROOT}/CMakeLists.txt" DESTINATION "${BUNDLE}/source")
file(READ "${BUILD}/lh_build_info.txt" info)
string(REPLACE "root=${RELEASE_ROOT}" "root=source" info "${info}")
string(REPLACE "emulator=wine" "emulator=" info "${info}")
string(REGEX REPLACE "launcher=[^\n]*" "launcher=" info "${info}")
string(REPLACE "${BUILD}/" "" info "${info}")
file(WRITE "${BUNDLE}/lh_build_info.txt" "${info}")
file(COPY "${RELEASE_ROOT}/tools/run_windows_bundle.cmake" DESTINATION "${BUNDLE}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${BUNDLE}.zip" --format=zip .
  WORKING_DIRECTORY "${BUNDLE}" COMMAND_ERROR_IS_FATAL ANY)
