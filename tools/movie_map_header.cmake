cmake_minimum_required(VERSION 3.21)
file(READ "${INPUT}" rows)
string(JSON row_type TYPE "${rows}")
if(NOT row_type STREQUAL "OBJECT")
  message(FATAL_ERROR "Expected a movie mapping object")
endif()
string(JSON row_count LENGTH "${rows}")
# JSON MEMBER sorts keys; retain source order to preserve the generated include.
string(REGEX MATCHALL "\"[^\"]+\"[ \t\r\n]*:[ \t\r\n]*\\{" members "${rows}")
set(keys "")
foreach(member IN LISTS members)
  string(REGEX REPLACE "^\"([^\"]+)\".*$" "\\1" key "${member}")
  list(APPEND keys "${key}")
endforeach()
list(REMOVE_DUPLICATES keys)
list(LENGTH keys key_count)
if(NOT key_count EQUAL row_count)
  message(FATAL_ERROR "Expected movie rows to be objects")
endif()
set(out "/* Generated from movies.json. No game bytes. */\n")
foreach(key IN LISTS keys)
  if(NOT key MATCHES "^[ \t]*([+-]?[0-9]+)[ \t]*:[ \t]*([+-]?[0-9]+)[ \t]*$")
    message(FATAL_ERROR "Invalid movie key: ${key}")
  endif()
  set(disc "${CMAKE_MATCH_1}")
  set(lba "${CMAKE_MATCH_2}")
  foreach(number disc lba)
    set(sign "")
    if("${${number}}" MATCHES "^-")
      set(sign "-")
    endif()
    string(REGEX REPLACE "^[+-]" "" ${number} "${${number}}")
    string(REGEX REPLACE "^0+" "" ${number} "${${number}}")
    if("${${number}}" STREQUAL "")
      set(${number} 0)
    else()
      set(${number} "${sign}${${number}}")
    endif()
  endforeach()
  foreach(field movie frames offset_frames)
    string(JSON ${field} GET "${rows}" "${key}" ${field})
  endforeach()
  if(NOT movie MATCHES "^disc[0-9][0-9]_[0-9][0-9]$")
    message(FATAL_ERROR "unsafe movie basename")
  endif()
  string(APPEND out "{${disc},${lba},${frames},${offset_frames},\"${movie}\"},\n")
endforeach()
if(CMAKE_HOST_WIN32)
  string(REPLACE "\n" "\r\n" out "${out}")
endif()
file(WRITE "${OUTPUT}" "${out}")
