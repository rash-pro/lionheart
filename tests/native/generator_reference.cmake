# Compare complete trees, including unexpected and missing files. Rewriting
# deliberately accepts the current generator, so it is never a test default.
file(GLOB_RECURSE files RELATIVE "${OUTPUT}" "${OUTPUT}/*")
list(SORT files)
set(actual "")
foreach(file IN LISTS files)
  if(NOT IS_DIRECTORY "${OUTPUT}/${file}")
    file(SHA256 "${OUTPUT}/${file}" digest)
    string(APPEND actual "${KEY}\t${file}\t${digest}\n")
  endif()
endforeach()
if(DEFINED REWRITE)
  file(WRITE "${REWRITE}" "${actual}")
  return()
endif()
file(STRINGS "${REFERENCE}" rows)
set(expected "")
foreach(row IN LISTS rows)
  string(FIND "${row}" "${KEY}\t" start)
  if(start EQUAL 0)
    string(APPEND expected "${row}\n")
    string(LENGTH "${KEY}" key_length)
    math(EXPR offset "${key_length} + 1")
    string(SUBSTRING "${row}" ${offset} -1 tail)
    string(FIND "${tail}" "\t" separator)
    string(SUBSTRING "${tail}" 0 ${separator} file)
    math(EXPR offset "${separator} + 1")
    string(SUBSTRING "${tail}" ${offset} -1 digest)
    if(NOT EXISTS "${OUTPUT}/${file}")
      message(FATAL_ERROR "${KEY}: missing ${file}")
    endif()
    file(SHA256 "${OUTPUT}/${file}" got)
    if(NOT got STREQUAL digest)
      message(FATAL_ERROR "${KEY}: changed ${file}: ${got}, expected ${digest}")
    endif()
  endif()
endforeach()
if(expected STREQUAL "" OR NOT actual STREQUAL expected)
  message(FATAL_ERROR "${KEY}: output file inventory differs\n${actual}")
endif()
