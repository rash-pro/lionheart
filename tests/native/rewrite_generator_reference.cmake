if(NOT DEFINED BUILD)
  message(FATAL_ERROR "Pass -DBUILD=<native test build>")
endif()
set(parts "${BUILD}/generator-reference-parts")
file(REMOVE_RECURSE "${parts}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LH_REWRITE_GENERATOR_REFERENCE=${parts}"
  "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" -R "^test_generator_parity::" -j4 --output-on-failure
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "generator cases failed; reference unchanged")
endif()
file(GLOB fragments "${parts}/*.tsv")
set(rows "")
foreach(fragment IN LISTS fragments)
  file(STRINGS "${fragment}" lines)
  list(APPEND rows ${lines})
endforeach()
list(SORT rows)
set(content "")
foreach(row IN LISTS rows)
  string(APPEND content "${row}\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/generator_reference.tsv" "${content}")
