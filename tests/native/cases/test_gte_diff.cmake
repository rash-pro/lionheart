foreach(mode exact play)
  set(extra)
  if(mode STREQUAL play)
    set(extra -DFF8_PLAY)
  endif()
  add_library(gte_diff_${mode}_reference OBJECT "${LH_ROOT}/runtime/gte.c")
  target_include_directories(gte_diff_${mode}_reference PRIVATE "${LH_ROOT}/runtime")
  target_compile_options(gte_diff_${mode}_reference PRIVATE -std=c99 -O2 ${extra}
    -DFF8_GTE_REFERENCE -Dgte_cmd=gte_reference_cmd -Dgte_read=gte_reference_read -Dgte_write=gte_reference_write)
  lh_harness(${mode} FLAGS -std=c99 -O2 -Wall -Wextra -Werror ${extra}
    INCLUDES runtime SOURCES tests/gte_diff.c runtime/gte.c)
  target_sources(test_gte_diff.${mode} PRIVATE $<TARGET_OBJECTS:gte_diff_${mode}_reference>)
endforeach()
file(STRINGS "${LH_ROOT}/runtime/gte.h" declarations REGEX "^void gte_")
set(wrap -Wl,--wrap=gte_cmd)
foreach(decl IN LISTS declarations)
  string(REGEX MATCH "gte_[a-z0-9_]+" symbol "${decl}")
  list(APPEND wrap "-Wl,--wrap=${symbol}")
endforeach()
foreach(specialized False True)
  set(extra)
  set(link -Wl,--wrap=gte_cmd)
  if(specialized STREQUAL True)
    set(extra -DFF8_GTE_SPECIALIZED_TRACE)
    set(link ${wrap})
  endif()
  lh_harness(record_${specialized} FLAGS -std=c99 -O2 -Wall -Wextra -Werror ${extra}
    INCLUDES runtime SOURCES tests/native/cases/test_gte_diff_record.c tools/gte_trace.c runtime/gte.c
    LINK_FLAGS ${link})
endforeach()
