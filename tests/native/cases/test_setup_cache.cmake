if(NOT CMAKE_CROSSCOMPILING)
  add_executable(test_setup_cache.driver "${LH_ROOT}/tests/native/support/cache_driver.c")
  target_link_libraries(test_setup_cache.driver PRIVATE lionheart_generator)
  set_property(GLOBAL APPEND PROPERTY LH_HARNESSES test_setup_cache.driver)
  add_executable(test_setup_cache.lionheart-gen ALIAS lionheart-gen)
  set_property(GLOBAL APPEND PROPERTY LH_HARNESSES test_setup_cache.lionheart-gen)
  add_executable(test_setup_cache.unit "${LH_ROOT}/generator/test/cache.c")
  target_include_directories(test_setup_cache.unit PRIVATE "${LH_ROOT}/generator/src")
  target_link_libraries(test_setup_cache.unit PRIVATE lionheart_generator)
  target_compile_options(test_setup_cache.unit PRIVATE -UNDEBUG)
  set_property(GLOBAL APPEND PROPERTY LH_HARNESSES test_setup_cache.unit)
endif()
if(NOT CMAKE_CROSSCOMPILING AND FF8_TEST_SANITIZE)
  foreach(target test_setup_cache.driver test_setup_cache.unit)
    target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    target_link_options(${target} PRIVATE -fsanitize=address,undefined)
  endforeach()
endif()
