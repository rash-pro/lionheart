# The Windows runner retains every identity, including cases whose host-side
# fixture still requires POSIX. Those cases report the prerequisite at runtime.
function(lh_windows_source_supported path output)
  file(READ "${path}" text)
  if(text MATCHES "generated.h|generator_shim.h|recompiler_fixture.h|vulkan.h|network.h|ra_service.h|synthetic_player.h|player_probe.h|frame_bench.h|tools/devtools/|SIGBUS|<sys/|<dlfcn.h>|setenv\\(|unsetenv\\(")
    set(${output} FALSE PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "#include \"[^\"]+\"" headers "${text}")
  foreach(header IN LISTS headers)
    string(REGEX REPLACE "#include \"([^\"]+)\"" "\\1" name "${header}")
    foreach(base "${CMAKE_CURRENT_SOURCE_DIR}/support" "${CMAKE_CURRENT_SOURCE_DIR}/cases" "${CMAKE_CURRENT_SOURCE_DIR}")
      if(EXISTS "${base}/${name}" AND NOT name STREQUAL "lh_test.h")
        lh_windows_source_supported("${base}/${name}" supported)
        if(NOT supported)
          set(${output} FALSE PARENT_SCOPE)
          return()
        endif()
      endif()
    endforeach()
  endforeach()
  set(${output} TRUE PARENT_SCOPE)
endfunction()
file(GLOB candidates "${CMAKE_CURRENT_SOURCE_DIR}/cases/*.cpp")
set(windows_sources)
set(windows_stems)
foreach(source IN LISTS candidates)
  lh_windows_source_supported("${source}" supported)
  if(supported)
    list(APPEND windows_sources "${source}")
    get_filename_component(stem "${source}" NAME_WE)
    list(APPEND windows_stems "${stem}")
  endif()
endforeach()
execute_process(COMMAND "${LH_HOST_RUNNER}" --list OUTPUT_VARIABLE inventory COMMAND_ERROR_IS_FATAL ANY)

set(stubs "#include \"lh_test.h\"\nnamespace { bool registered = [] {\n")
while(NOT inventory STREQUAL "")
  string(FIND "${inventory}" "\n" end)
  if(end LESS 0)
    set(row "${inventory}")
    set(inventory "")
  else()
    string(SUBSTRING "${inventory}" 0 ${end} row)
    math(EXPR next "${end}+1")
    string(SUBSTRING "${inventory}" ${next} -1 inventory)
  endif()
  if(row MATCHES "^(standard|game|realtime)\t([^:]+)::(.*)$")
    set(tier "${CMAKE_MATCH_1}")
    set(stem "${CMAKE_MATCH_2}")
    set(name "${CMAKE_MATCH_3}")
    if(NOT stem IN_LIST windows_stems)
      string(APPEND stubs "lh::add_unavailable_case(\"${stem}.cpp\", R\"lhcase(${name})lhcase\", lh::Tier::${tier}, \"host fixture requires POSIX or an on-demand native build\");\n")
    endif()
  endif()
endwhile()
string(APPEND stubs "return true; }(); }\n")
file(WRITE "${CMAKE_BINARY_DIR}/windows_cases.cpp" "${stubs}")
add_executable(lionheart_windows_tests support/runner.cpp support/fixtures.cpp support/process_windows.cpp
  support/windows_streams.c
  ${windows_sources} "${CMAKE_BINARY_DIR}/windows_cases.cpp")
target_include_directories(lionheart_windows_tests PRIVATE support "${CMAKE_CURRENT_SOURCE_DIR}")
target_compile_features(lionheart_windows_tests PRIVATE cxx_std_17)
target_compile_options(lionheart_windows_tests PRIVATE -UNDEBUG)
set_target_properties(lionheart_windows_tests PROPERTIES OUTPUT_NAME lionheart_tests)
target_link_libraries(lionheart_windows_tests PRIVATE ws2_32)
