# Run against an idle native build; every source is restored before reporting.
cmake_minimum_required(VERSION 3.21)
if(NOT BUILD)
  message(FATAL_ERROR "Pass -DBUILD=<native test build>")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(generator "${root}/generator/src/generator.c")
set(cache "${root}/generator/src/cache.c")
set(catalog "${root}/generator/src/catalog.c")
file(READ "${generator}" original_generator)
file(READ "${cache}" original_cache)
file(READ "${catalog}" original_catalog)
set(failures "")
foreach(mutation invalidate digest fingerprint duplicate publish)
  set(g "${original_generator}")
  set(c "${original_cache}")
  set(d "${original_catalog}")
  if(mutation STREQUAL "invalidate")
    string(REPLACE "lhg_output_cache_invalidate(&arena, options->output_dir);" "" g "${g}")
    set(case "cancelled_emission")
  elseif(mutation STREQUAL "digest")
    string(REPLACE "lhg_text_adds(text, hex);" "lhg_text_adds(text, \"digest ignored\");" c "${c}")
    set(case "output_invalidation")
  elseif(mutation STREQUAL "fingerprint")
    string(REPLACE "add_string(&hash, lhg_generator_fingerprint());" "" c "${c}")
    set(case "source_fingerprint")
  elseif(mutation STREQUAL "duplicate")
    string(REPLACE "lhg_fail(ctx, \"the same disc was supplied more than once\");" "(void)0;" d "${d}")
    set(case "disc_rules")
  else()
    string(REPLACE "    if (options->use_cache)\n        lhg_output_cache_save(&arena, options->output_dir, cache_key);" "" g "${g}")
    string(REPLACE "    lhg_emit_options emit_options" "    if (options->use_cache)\n        lhg_output_cache_save(&arena, options->output_dir, cache_key);\n    lhg_emit_options emit_options" g "${g}")
    set(case "cancelled_emission")
  endif()
  file(WRITE "${generator}" "${g}")
  file(WRITE "${cache}" "${c}")
  file(WRITE "${catalog}" "${d}")
  execute_process(COMMAND nice -n 10 "${CMAKE_COMMAND}" --build "${BUILD}" --target test_setup_cache.driver lionheart-gen -j4 RESULT_VARIABLE built OUTPUT_QUIET ERROR_VARIABLE err)
  if(built EQUAL 0)
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" -R "test_setup_cache::${case}" --output-on-failure
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE err)
    message(STATUS "${mutation}: ${output}")
    if(result EQUAL 0)
      list(APPEND failures "${mutation} survived")
    endif()
  else()
    list(APPEND failures "${mutation} did not build: ${err}")
  endif()
  file(WRITE "${generator}" "${original_generator}")
  file(WRITE "${cache}" "${original_cache}")
  file(WRITE "${catalog}" "${original_catalog}")
endforeach()
execute_process(COMMAND nice -n 10 "${CMAKE_COMMAND}" --build "${BUILD}" --target test_setup_cache.driver lionheart-gen -j4 RESULT_VARIABLE restored OUTPUT_QUIET)
if(failures OR NOT restored EQUAL 0)
  message(FATAL_ERROR "Mutation checks failed: ${failures}; restore build=${restored}")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" -R "test_setup_cache::" --output-on-failure RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Restored cache tests failed")
endif()
