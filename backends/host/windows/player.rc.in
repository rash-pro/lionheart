#include <winver.h>
1 24 "@CMAKE_SOURCE_DIR@/backends/host/windows/player.manifest"
1 ICON "@CMAKE_SOURCE_DIR@/assets/logo/lionheart.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Lionheart\0"
   VALUE "ProductName", "Lionheart\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "Lionheart.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
